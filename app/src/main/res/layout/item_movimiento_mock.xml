<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_rounded_card"> <ImageView
    android:id="@+id/imgIconoMovimiento"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:src="@drawable/ic_arrow_up"
    app:tint="#EF4444"
    android:background="#FEE2E2"
    android:padding="8dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvConceptoMovimiento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Transferencia"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        app:layout_constraintStart_toEndOf="@id/imgIconoMovimiento"
        app:layout_constraintTop_toTopOf="@id/imgIconoMovimiento"
        app:layout_constraintBottom_toTopOf="@id/tvFechaMovimiento"
        app:layout_constraintEnd_toStartOf="@id/tvMontoMovimiento"/>

    <TextView
        android:id="@+id/tvFechaMovimiento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="10 Jun 2026"
        android:textSize="12sp"
        android:textColor="#647488"
        app:layout_constraintStart_toStartOf="@id/tvConceptoMovimiento"
        app:layout_constraintTop_toBottomOf="@id/tvConceptoMovimiento"
        app:layout_constraintBottom_toBottomOf="@id/imgIconoMovimiento"/>

    <TextView
        android:id="@+id/tvMontoMovimiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- $0.00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#EF4444"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>