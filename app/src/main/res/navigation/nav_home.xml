<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_home"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.mibanca.view.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_navigation_home_to_transferirSeleccionFragment"
            app:destination="@id/transferirSeleccionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/navigation_beneficiarios"
        android:name="com.example.mibanca.view.BeneficiariosFragment"
        android:label="Beneficiarios"
        tools:layout="@layout/fragment_beneficiarios" />

    <fragment
        android:id="@+id/navigation_cuenta"
        android:name="com.example.mibanca.view.CuentaFragment"
        android:label="Cuenta"
        tools:layout="@layout/fragment_cuenta" />

    <fragment
        android:id="@+id/transferirSeleccionFragment"
        android:name="com.example.mibanca.view.TransferirSeleccionFragment"
        android:label="Seleccionar Beneficiario"
        tools:layout="@layout/fragment_transferir_seleccion">

        <action
            android:id="@+id/action_transferirSeleccionFragment_to_transferirMontoFragment"
            app:destination="@id/transferirMontoFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/transferirMontoFragment"
        android:name="com.example.mibanca.view.TransferirMontoFragment"
        android:label="Monto y Concepto"
        tools:layout="@layout/fragment_transferir_monto">

        <argument
            android:name="beneficiaryId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/fragment_registro_beneficiario"
        android:name="com.example.mibanca.view.RegistroBeneficiarioFragment"
        android:label="Formulario Beneficiario"
        tools:layout="@layout/fragment_registro_beneficiario" />

</navigation>
