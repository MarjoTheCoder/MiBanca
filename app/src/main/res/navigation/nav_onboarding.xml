<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_onboarding"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.mibanca.view.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.mibanca.view.RegisterFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_personalData"
            app:destination="@id/personalDataFragment" />
    </fragment>

    <fragment
        android:id="@+id/personalDataFragment"
        android:name="com.example.mibanca.view.PersonalDataFragment"
        android:label="Datos Personales"
        tools:layout="@layout/fragment_personal_data" />

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.mibanca.view.RecoverPasswordFragment"
        android:label="Recuperar contraseña"
        tools:layout="@layout/fragment_password" />

</navigation>